<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="Campus" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=CampusBookings;Integrated Security=True;Connect Timeout=8" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="128" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="480" slidingExpiration="false" cookieless="UseCookies" protection="All" cookieSameSite="Lax" />
    </authentication>
    <sessionState mode="InProc" timeout="20" cookieless="UseCookies" cookieSameSite="Lax" />
    <httpCookies httpOnlyCookies="true" sameSite="Lax" />
    <customErrors mode="On" defaultRedirect="~/Error.aspx" />
    <pages enableEventValidation="true" enableViewStateMac="true" />
  </system.web>
  <system.webServer>
    <defaultDocument><files><clear /><add value="Login.aspx" /></files></defaultDocument>
    <httpProtocol><customHeaders><add name="X-Content-Type-Options" value="nosniff" /><add name="X-Frame-Options" value="DENY" /><add name="Referrer-Policy" value="same-origin" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
